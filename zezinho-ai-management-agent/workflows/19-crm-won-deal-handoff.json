    {
      "name": "Funis",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.3,
      "position": [
        224,
        96
      ],
      "parameters": {
        "method": "GET",
        "url": "https://crm.rdstation.com/api/v1/deal_pipelines",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpQueryAuth",
        "options": {}
      },
      "credentials": {
        "httpQueryAuth": {
          "id": "<CREDENTIAL_ID>",
          "name": "httpQueryAuth"
        }
      }
    },
    {
      "name": "Funil REDACTED",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        448,
        96
      ],
      "parameters": {
        "jsCode": "// Conta RD é compartilhada (Redacted, Redacted...): usar só o funil da REDACTED.\nconst p = $input.all().map(i => i.json).find(x => (x.name || '').toUpperCase().includes('REDACTED'));\nif (!p) throw new Error('Funil REDACTED CONTABILIDADE não encontrado no RD.');\nreturn [{ json: { pipelineId: p.id, nome: p.name, etapas: (p.deal_stages || []).map(s => s.id) } }];"
      }
    },
    {
      "name": "Negociações ganhas",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.3,
      "position": [
        672,
        96
      ],
      "parameters": {
        "method": "GET",
        "url": "https://crm.rdstation.com/api/v1/deals",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpQueryAuth",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "deal_pipeline_id",
              "value": "={{ $json.pipelineId }}"
            },
            {
              "name": "win",
              "value": "true"
            },
            {
              "name": "limit",
              "value": "200"
            }
          ]
        },
        "options": {}
      },
      "credentials": {
        "httpQueryAuth": {
          "id": "<CREDENTIAL_ID>",
          "name": "httpQueryAuth"
        }
      }
    },
    {
      "name": "Vendas recentes (4 dias)",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        896,
        96
      ],
      "parameters": {
        "jsCode": "// Só vendas ganhas nos últimos 4 dias (cobre fim de semana; evita avisar as antigas); a tabela de avisadas tira as repetidas.\nconst etapas = new Set($('Funil REDACTED').first().json.etapas);\nconst limite = Date.now() - 4 * 86400000;\nconst brl = v => Number(v || 0).toLocaleString('pt-BR', { style: 'currency', currency: 'BRL' });\nconst fmt = d => new Date(d).toLocaleDateString('pt-BR', { timeZone: 'America/Sao_Paulo' });\nconst deals = ($input.first().json.deals || []).filter(d => d.win === true && etapas.has(d.deal_stage && d.deal_stage.id));\nconst out = [];\nfor (const d of deals) {\n  const quando = d.closed_at || d.updated_at;\n  if (!quando || new Date(quando).getTime() < limite) continue;\n  const cliente = (d.organization && d.organization.name) || d.name;\n  // \"Valor da oportunidade\" é o produto genérico do RD: não diz o serviço\n  const servicos = (d.deal_products || []).map(p => p.name).filter(n => n && !/valor da oportunidade/i.test(n)).join(', ');\n  const mensal = Number(d.amount_montly || 0);\n  const unico = Number(d.amount_unique || 0);\n  const valor = mensal || unico || Number(d.amount_total || 0);\n  const valorTxt = [mensal ? brl(mensal) + '/mês' : '', unico ? brl(unico) + ' (único)' : ''].filter(Boolean).join(' + ') || (valor ? brl(valor) : 'não informado');\n  const vendedor = (d.user && d.user.name) || 'não informado';\n  const contato = ((d.contacts || [])[0] || {}).name;\n  const texto = '*🎉 Nova venda fechada!*\\n'\n    + '• *Negociação:* ' + (d.organization && d.organization.name ? d.organization.name + ' — ' : '') + d.name + '\\n'\n    + (servicos ? '• *Serviço:* ' + servicos + '\\n' : '')\n    + '• *Valor:* ' + valorTxt + '\\n'\n    + (contato ? '• *Contato:* ' + contato + '\\n' : '')\n    + '• *Vendedor(a):* ' + vendedor + '\\n'\n    + '• *Fechado em:* ' + fmt(quando) + '\\n\\n'\n    + '👉 CS: iniciar o onboarding.';\n  out.push({ json: { deal_id: String(d.id || d._id), cliente, vendedor, valor, ganha_em: fmt(quando), texto } });\n}\nreturn out;"
      }
    },
