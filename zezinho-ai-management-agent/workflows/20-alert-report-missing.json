              "field": "cronExpression",
              "expression": "40 18 * * 1-5"
            }
          ]
        }
      }
    },
    {
      "name": "Último relatório diário",
      "type": "n8n-nodes-base.dataTable",
      "typeVersion": 1.1,
      "position": [
        224,
        0
      ],
      "parameters": {
        "resource": "row",
        "operation": "get",
        "dataTableId": {
          "__rl": true,
          "mode": "id",
          "value": "<DATATABLEID>"
        },
        "matchType": "allConditions",
        "filters": {
          "conditions": [
            {
              "keyName": "tipo",
              "condition": "eq",
              "keyValue": "relatorio_diario"
