    {
      "name": "Saiu hoje?",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        448,
        0
      ],
      "parameters": {
        "jsCode": "// O relatório das 18h10 usa message_id 'relatorio-AAAA-MM-DD' com a data dos chats (= hoje).\nconst hoje = $now.setZone('America/Sao_Paulo').toFormat('yyyy-MM-dd');\nconst linhas = $input.all().map(i => i.json).filter(l => l.message_id);\nif (linhas.some(l => l.message_id === 'relatorio-' + hoje)) return [];\nconst u = linhas[0];\nconst ultimo = u ? 'O último foi o ' + u.message_id + ' (status: ' + (u.status || '?') + ').' : 'Nenhum relatório diário encontrado ainda.';\nreturn [{ json: { texto: '⚠️ *Alerta do Zezinho*\\nO relatório diário de gestão das 18h10 NÃO chegou para aprovação hoje (' + hoje + '). ' + ultimo + '\\nVerifique o agente Gestor Contábil IA no n8n (tarefa das 18h10) ou se o saldo de créditos do Gemini acabou.' } }];"
      }
    },
    {
      "name": "Achar privado do Redacted",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        672,
        0
      ],
      "parameters": {
        "url": "https://chat.googleapis.com/v1/spaces:findDirectMessage?name=users/<EMAIL>",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "googleChatOAuth2Api",
        "options": {}
      },
      "credentials": {
        "googleChatOAuth2Api": {
          "id": "<CREDENTIAL_ID>",
          "name": "googleChatOAuth2Api"
        }
      }
    },
    {
      "name": "Avisar no privado",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        896,
        0
      ],
      "parameters": {
        "method": "POST",
        "url": "=https://chat.googleapis.com/v1/{{ $json.name }}/messages",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "googleChatOAuth2Api",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ text: $('Saiu hoje?').first().json.texto }) }}",
        "options": {}
      },
      "credentials": {
        "googleChatOAuth2Api": {
          "id": "<CREDENTIAL_ID>",
          "name": "googleChatOAuth2Api"
        }
      }
    }
