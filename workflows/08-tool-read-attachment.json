      "position": [
        1120,
        576
      ],
      "parameters": {
        "operation": "csv",
        "binaryPropertyName": "data",
        "options": {
          "headerRow": true,
          "relaxQuotes": true
        }
      }
    },
    {
      "name": "Ler texto",
      "type": "n8n-nodes-base.extractFromFile",
      "typeVersion": 1.1,
      "position": [
        1120,
        768
      ],
      "parameters": {
        "operation": "text",
        "binaryPropertyName": "data",
        "destinationKey": "data"
      }
    },
    {
      "name": "Avisar formato não lido",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        1120,
        960
      ],
      "parameters": {
        "mode": "manual",
        "includeOtherFields": false,
        "assignments": {
          "assignments": [
            {
              "id": "n",
              "name": "nome",
              "value": "={{ $json.nome }}",
              "type": "string"
            },
            {
              "id": "c",
              "name": "conteudo",
              "value": "={{ 'Não consegui ler este arquivo automaticamente (formato: ' + $json.formato + ($json.mime ? ', ' + $json.mime : '') + '). ' + ($json.erro || '') + ' Avalie só pelo texto da mensagem e, se for um relatório, sugira enviar em PDF ou planilha.' }}",
              "type": "string"
            }
          ]
        }
      }
    }
  ],
