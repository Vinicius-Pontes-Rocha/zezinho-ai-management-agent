      "position": [
        224,
        192
      ],
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "aprovador",
              "name": "aprovador_email",
              "value": "={{ $json.aprovador_email || '<EMAIL>' }}",
              "type": "string"
            }
          ]
        },
        "includeOtherFields": true,
        "options": {}
      }
    },
    {
      "name": "Achar conversa direta do aprovador",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        448,
        192
      ],
      "parameters": {
        "url": "=https://chat.googleapis.com/v1/spaces:findDirectMessage?name=users/{{ $json.aprovador_email }}",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "googleChatOAuth2Api",
        "options": {}
      },
      "credentials": {
        "googleChatOAuth2Api": {
          "id": "<CREDENTIAL_ID>",
          "name": "googleChatOAuth2Api"
        }
      }
    },
    {
      "name": "Pedir aprovação",
      "type": "n8n-nodes-base.googleChat",
      "typeVersion": 1,
      "position": [
        672,
        192
      ],
      "parameters": {
        "authentication": "oAuth2",
        "operation": "sendAndWait",
        "spaceId": "={{ $('Achar conversa direta do aprovador').item.json.name }}",
        "message": "=👆 *Aprovar a mensagem acima?*\nTipo: {{ $('Receber pedido').item.json.tipo }} | Se publicar, sai em: {{ $('Receber pedido').item.json.tipo === 'relatorio_diario' ? 'REDACTED | Geral' : $('Receber pedido').item.json.space_nome }}",
        "approvalOptions": {
          "values": {
            "approvalType": "double",
            "approveLabel": "✅ Publicar",
            "disapproveLabel": "❌ Rejeitar"
          }
        },
        "options": {
          "limitWaitTime": {
            "values": {
              "resumeAmount": 3,
              "resumeUnit": "days"
            }
          },
          "appendAttribution": false
        }
      },
      "credentials": {
        "googleChatOAuth2Api": {
          "id": "<CREDENTIAL_ID>",
          "name": "googleChatOAuth2Api"
        }
      }
    },
    {
      "name": "Decisão",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3.2,
      "position": [
        896,
        176
      ],
      "parameters": {
        "rules": {
          "values": [
            {
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "leftValue": "",
                  "typeValidation": "strict",
                  "version": 2
                },
                "conditions": [
                  {
                    "leftValue": "={{ !!($json.data && $json.data.approved === true) }}",
                    "operator": {
                      "type": "boolean",
                      "operation": "true",
                      "singleValue": true
                    },
                    "id": "<ID>"
                  }
                ],
                "combinator": "and"
              }
            },
            {
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "leftValue": "",
                  "typeValidation": "strict",
                  "version": 2
                },
                "conditions": [
                  {
                    "leftValue": "={{ !!($json.data && $json.data.approved === false) }}",
                    "operator": {
                      "type": "boolean",
                      "operation": "true",
                      "singleValue": true
                    },
                    "id": "<ID>"
                  }
                ],
                "combinator": "and"
              }
            }
          ]
        },
        "options": {
          "fallbackOutput": "extra",
          "renameFallbackOutput": "Expirou"
        }
      }
    },
