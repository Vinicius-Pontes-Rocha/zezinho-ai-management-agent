        "jsCode": "// 27/10: relatório publicado → avisa o outro aprovador para não procurar o botão à toa.\nconst R = $('Receber pedido').first().json;\nif (R.tipo !== 'relatorio_diario') return [];\nconst TODOS = ['<EMAIL>', '<EMAIL>'];\nconst eu = $('Config - quem aprova').first().json.aprovador_email;\nconst nome = e => e === TODOS[1] ? 'CEO' : 'Redacted';\nreturn TODOS.filter(e => e !== eu).map(e => ({ json: { email: e, texto: '✅ ' + (R.titulo || 'Relatório') + ' já foi publicado no REDACTED | Geral (aprovado pelo ' + nome(eu) + '). Não precisa aprovar a sua cópia.' } }));"
